{
  "name": "mytimetable-backend",
  "version": "1.0.0",
  "description": "Backend for MyTimetable app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "db:generate": "npx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "npx drizzle-kit push --config=drizzle.config.ts",
    "test": "cd ./src/tests && chmod u+x test-backend.sh && ./test-backend.sh"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
